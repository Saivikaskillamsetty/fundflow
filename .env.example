# Postgres (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgres://fundflow:fundflow@localhost:5433/fundflow

# Redis (docker-compose maps container 6379 -> host 6380)
REDIS_URL=redis://localhost:6380

# AI insights provider: ollama (free local) | groq (free fast cloud) | anthropic
LLM_PROVIDER=groq
# Ollama — free, local, no key. Requires `ollama serve` + model pulled.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Groq — free fast cloud (~500 tok/s). Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# Anthropic — paid; only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Signal classification threshold (absolute pct points of net-asset weight)
SIGNAL_THRESHOLD=0.10

# Python interpreter used to run the parser (point at parser venv)
PYTHON_BIN=parser/.venv/bin/python

# ---------------------------------------------------------------------------
# Deployment (see DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# File storage driver: local | blob. Defaults to blob when a blob token is set,
# otherwise local disk under ./uploads. Split deploys (Vercel + worker host)
# must use blob — the two halves do not share a filesystem.
STORAGE_DRIVER=local
# Vercel Blob token (Vercel injects this automatically on its own deploys).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Managed Redis uses rediss:// with credentials; the URL is parsed in full
# (username, password, TLS), e.g. rediss://default:<pw>@<host>.upstash.io:6379
# Managed Postgres (Neon) needs sslmode=require in DATABASE_URL.

# Worker-host only: headless Chrome binary used for AMC discovery.
# CHROME_PATH=/usr/bin/chromium
