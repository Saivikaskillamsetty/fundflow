# Postgres (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgres://fundflow:fundflow@localhost:5433/fundflow

# AI insights provider: ollama (free local) | groq (free fast cloud) | anthropic
LLM_PROVIDER=groq
# Ollama — free, local, no key. Requires `ollama serve` + model pulled.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Groq — free fast cloud (~500 tok/s). Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# Anthropic — paid; only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Signal classification threshold (absolute pct points of net-asset weight)
SIGNAL_THRESHOLD=0.10

# Python interpreter for the parser. Used only when PARSER_URL is unset — i.e.
# local dev and tests, which run parser/extract.py as a subprocess.
PYTHON_BIN=parser/.venv/bin/python

# ---------------------------------------------------------------------------
# Deployment (see DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# File storage driver: local | blob. Defaults to blob when a blob token is set,
# otherwise local disk under ./uploads. Deployed this must be blob: the Python
# parse function reads the file back by URL.
STORAGE_DRIVER=local
# Vercel Blob token (Vercel injects this automatically on its own deploys).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Shared secret for the Python parse function (api/parse.py). Required in any
# environment where the parser runs over HTTP.
PARSER_SECRET=

# Guards /api/cron/sync and /api/sync/[amc], and authenticates the fan-out's
# calls to itself. Vercel sends this as `Authorization: Bearer` on cron runs.
CRON_SECRET=

# Override the parse function's URL. Unset on Vercel (derived from VERCEL_URL);
# unset locally, which selects the subprocess transport instead.
# PARSER_URL=https://<deployment>/api/parse

# Day of month the cron actually performs a sync (SEBI gives AMCs ~10 days
# after month-end, so the 12th reliably has the prior month).
# SYNC_DAY_OF_MONTH=12

# Files processed concurrently within one AMC. HDFC publishes ~40 workbooks per
# run; sequential would approach the 300s function ceiling.
# SYNC_FILE_CONCURRENCY=4

# Managed Postgres (Neon) needs sslmode=require in DATABASE_URL.

# Monthly report email, sent by /api/cron/sync after each run (production).
# Without RESEND_API_KEY the cron still works and simply skips the email.
# Free key: https://resend.com — the default onboarding@resend.dev sender can
# only deliver to the Resend account owner's own address.
# RESEND_API_KEY=re_...
# REPORT_EMAIL_TO=you@example.com
# REPORT_EMAIL_FROM=FundFlow <onboarding@resend.dev>

# Passphrase for /runs and its "Run sync now" button (src/lib/admin-auth.ts).
# Unset = the admin area is closed. Any non-empty string works.
# ADMIN_PASSWORD=choose-something-long
